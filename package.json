{
  "name": "jarvis-agent",
  "version": "1.0.0",
  "description": "JARVIS — Master Autonomous AI Agent System",
  "main": "dist/server/index.js",
  "scripts": {
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:server && npm run build:client",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "start:server": "node dist/server/index.js",
    "start:worker": "node dist/devices/desktop-worker.js",
    "dev:server": "ts-node src/server/index.ts",
    "dev:worker": "ts-node src/devices/desktop-worker.ts",
    "dev:client": "npm --prefix client run dev",
    "dev": "ts-node src/server/index.ts",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "setup": "npm install && npm run prisma:generate && npm run prisma:push"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
