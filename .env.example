# Server Configuration
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (SQLite default for zero-setup local persistence; PostgreSQL compatible)
DATABASE_URL="file:./dev.db"

# Authentication & Security
JWT_SECRET=jarvis-local-dev-jwt-secret-do-not-use-in-production-32bytes-min
SESSION_EXPIRY=7d

# Model Providers (Optional: system falls back to Deterministic Mock Model Provider when unset)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ACTIVE_MODEL_PROVIDER=mock

# Agent Execution & Policy Parameters
EXECUTION_LEASE_DURATION_MS=60000
MAX_RECOVERY_RETRIES=2
MAX_CONCURRENT_STEPS_PER_USER=4
AUTO_APPROVE_RISK_LEVEL_UP_TO=1
